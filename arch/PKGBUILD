# Maintainer: JadenJSJ <jadenjsj@proton.me>
# Based on the Arch Linux powerdevil package.

pkgname=powerdevil
pkgver=6.6.4
pkgrel=14
pkgdesc='Manages the power consumption settings of a Plasma Shell (DDC brightness range guard)'
arch=(x86_64)
url='https://github.com/JSJ-Experiments/powerdevil-ddc-brightness-fix'
license=(LGPL-2.0-or-later)
depends=(ddcutil glibc plasma-activities kauth kcmutils kconfig kcoreaddons kcrash
         kdbusaddons kglobalaccel ki18n kidletime kirigami kitemmodels knotifications
         kpackage kservice kxmlgui libkscreen libplasma libstdc++ libxcb plasma-workspace
         qcoro qt6-base qt6-declarative solid systemd-libs wayland)
makedepends=(extra-cmake-modules kdoctools plasma-wayland-protocols)
optdepends=('kinfocenter: for the Energy Information KCM'
            'power-profiles-daemon: power profiles support'
            'tlp: alternative power profiles support')
groups=(plasma)
_commit=e009ae5342ce2b913420880438abb861e9ddcf8c
source=("$pkgname::git+$url.git#commit=$_commit")
sha256sums=('SKIP')

build() {
  cmake -B build -S "$srcdir/$pkgname" \
    -DCMAKE_INSTALL_PREFIX=/usr \
    -DCMAKE_INSTALL_LIBEXECDIR=lib \
    -DBUILD_TESTING=OFF
  cmake --build build --parallel 4
}

package() {
  # QML plugins use Qt's private C++ ABI. A package built on a newer Arch
  # image can fail to load on a host with an older Qt, even at the same Plasma
  # version. Require the exact Qt builds used for this package.
  local qt_base_version qt_declarative_version
  qt_base_version=$(pacman -Q qt6-base | awk '{print $2}') || return
  qt_declarative_version=$(pacman -Q qt6-declarative | awk '{print $2}') || return
  [[ -n $qt_base_version && -n $qt_declarative_version ]] || return 1
  local i
  for i in "${!depends[@]}"; do
    case ${depends[i]} in
      qt6-base) depends[i]="qt6-base=$qt_base_version" ;;
      qt6-declarative) depends[i]="qt6-declarative=$qt_declarative_version" ;;
    esac
  done
  DESTDIR="$pkgdir" cmake --install build
}
